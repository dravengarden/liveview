{
  "interactiveView": 1,

  "data": {
    "sample": {
      "columns": { "day": "integer", "value": "number" },
      "values": [
        { "day": 1, "value": 3.2 },
        { "day": 2, "value": 4.1 },
        { "day": 3, "value": 3.8 },
        { "day": 4, "value": 5.0 },
        { "day": 5, "value": 4.6 }
      ]
    }
  },

  "signals": {
    "rate": {
      "type": "number", "init": 0.03,
      "widget": { "type": "slider", "min": 0, "max": 0.1, "step": 0.005, "label": "Rate (slider)" }
    },
    "band": {
      "type": "interval<number>", "init": [1, 4],
      "widget": { "type": "rangeSlider", "min": 1, "max": 5, "step": 1, "label": "Day band (rangeSlider)" }
    },
    "amount": {
      "type": "number", "init": 100,
      "widget": { "type": "numberInput", "min": 0, "max": 1000, "step": 10, "label": "Amount (numberInput)" }
    },
    "count": {
      "type": "integer", "init": 3,
      "widget": { "type": "stepper", "min": 0, "max": 10, "label": "Count (stepper)" }
    },
    "logScale": {
      "type": "boolean", "init": false,
      "widget": { "type": "toggle", "label": "Log scale (toggle)" }
    },
    "window": {
      "type": "enum", "init": 30,
      "widget": { "type": "segmented", "label": "Window (segmented, ≤5)",
        "options": [ { "label": "7d", "value": 7 }, { "label": "30d", "value": 30 }, { "label": "90d", "value": 90 } ] }
    },
    "mode": {
      "type": "enum", "init": "abs",
      "widget": { "type": "radioGroup", "label": "Mode (radioGroup)",
        "options": [ { "label": "Absolute", "value": "abs" }, { "label": "Relative", "value": "rel" } ] }
    },
    "metric": {
      "type": "enum", "init": "sharpe",
      "widget": { "type": "select", "label": "Metric (select)",
        "options": [ { "label": "Sharpe", "value": "sharpe" }, { "label": "Sortino", "value": "sortino" },
                     { "label": "Calmar", "value": "calmar" }, { "label": "Max drawdown", "value": "mdd" } ] }
    },
    "series": {
      "type": "array<enum>", "init": ["a", "b"],
      "widget": { "type": "multiSelect", "label": "Series (multiSelect)",
        "options": [ { "label": "Alpha", "value": "a" }, { "label": "Beta", "value": "b" },
                     { "label": "Gamma", "value": "c" } ] }
    },
    "flags": {
      "type": "array<enum>", "init": ["grid"],
      "widget": { "type": "checkboxGroup", "label": "Overlays (checkboxGroup)",
        "options": [ { "label": "Gridlines", "value": "grid" }, { "label": "Legend", "value": "legend" },
                     { "label": "Points", "value": "points" } ] }
    },
    "title": {
      "type": "string", "init": "My report",
      "widget": { "type": "textInput", "label": "Title (textInput)", "maxLength": 40 }
    },
    "asOf": {
      "type": "temporal", "init": "2026-07-01",
      "widget": { "type": "datePicker", "label": "As of (datePicker)", "min": "2026-01-01", "max": "2026-12-31" }
    },
    "range": {
      "type": "interval<temporal>", "init": ["2026-06-01", "2026-06-30"],
      "widget": { "type": "dateRange", "label": "Range (dateRange)", "min": "2026-01-01", "max": "2026-12-31" }
    },

    "bandMean": {
      "type": "number",
      "derived": "mean(filter(sample, day >= band[0] && day <= band[1]).value)"
    }
  },

  "view": [
    { "block": "section", "md": "# {{title}}\n\nEvery widget in the v1 catalog is instanced below and echoed live, so each control is visibly wired to its signal. This one document is the review artifact that certifies the whole widget alphabet." },

    { "block": "callout", "kind": "note",
      "md": "The `button` at the bottom resets every control to its initial value — a momentary action, not a stored value." },

    { "block": "section", "md": "## Live values" },
    { "block": "metricGroup", "items": [
      { "label": "Rate", "value": "{{rate}}", "format": "0.0%" },
      { "label": "Day band", "value": "{{band[0]}}–{{band[1]}}" },
      { "label": "Amount", "value": "{{amount}}", "format": "$0,0" },
      { "label": "Count", "value": "{{count}}" },
      { "label": "Log scale", "value": "{{logScale}}" },
      { "label": "Window", "value": "{{window}}d" },
      { "label": "Mode", "value": "{{mode}}" },
      { "label": "Metric", "value": "{{metric}}" },
      { "label": "Series", "value": "{{series | join(', ')}}" },
      { "label": "Overlays", "value": "{{flags | join(', ')}}" },
      { "label": "As of", "value": "{{asOf | date('YYYY-MM-DD')}}" },
      { "label": "Range", "value": "{{range[0] | date('MM-DD')}} → {{range[1] | date('MM-DD')}}" },
      { "label": "Band mean", "value": "{{bandMean | round(2)}}" }
    ] },

    { "block": "section", "md": "## Controls" },
    { "block": "columns", "collapse": true, "children": [
      { "block": "stack", "children": [
        { "block": "input", "signal": "rate" },
        { "block": "input", "signal": "band" },
        { "block": "input", "signal": "amount" },
        { "block": "input", "signal": "count" },
        { "block": "input", "signal": "logScale" },
        { "block": "input", "signal": "window" },
        { "block": "input", "signal": "mode" }
      ] },
      { "block": "stack", "children": [
        { "block": "input", "signal": "metric" },
        { "block": "input", "signal": "series" },
        { "block": "input", "signal": "flags" },
        { "block": "input", "signal": "title" },
        { "block": "input", "signal": "asOf" },
        { "block": "input", "signal": "range" }
      ] }
    ] },

    { "block": "section", "md": "## Widget → chart wiring" },
    { "block": "section", "md": "The `rangeSlider` above filters this chart; `bandMean` (a derived cell) is **{{bandMean | round(2)}}**." },
    { "block": "chart", "id": "sampleChart", "data": "sample",
      "vega": {
        "mark": { "type": "bar" },
        "transform": [ { "filter": "datum.day >= band[0] && datum.day <= band[1]" } ],
        "encoding": {
          "x": { "field": "day", "type": "ordinal" },
          "y": { "field": "value", "type": "quantitative" }
        }
      } },

    { "block": "input", "signal": null,
      "widget": { "type": "button", "label": "Reset all",
        "action": { "reset": ["rate", "band", "amount", "count", "logScale", "window",
                              "mode", "metric", "series", "flags", "title", "asOf", "range"] } } }
  ]
}
