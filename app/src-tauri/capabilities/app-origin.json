{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-origin",
  "description": "The SPA loads from the host-served OTA origin lvsync://localhost/app/. That origin needs its own core, haptics, and opener grants because capabilities are matched per origin.",
  "windows": ["main"],
  "remote": {
    "urls": ["lvsync://localhost", "lvsync://localhost/*"]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "sidestore:*" },
        { "url": "itms-apps:*" },
        { "url": "app-settings:*" }
      ]
    },
    "haptics:allow-impact-feedback",
    "haptics:allow-notification-feedback",
    "haptics:allow-selection-feedback",
    "haptics:allow-vibrate"
  ]
}
