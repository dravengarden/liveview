{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveView",
  "version": "0.1.0",
  "identifier": "top.thundersparrow.liveview",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LiveView",
        "url": "lvsync://localhost/app/index.html",
        "width": 1100,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
